{
  "name": "kevlar-codex-desktop",
  "productName": "Kevlar Codex Desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first Electron desktop control plane for Codex CLI agent orchestration.",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "prestart": "npm run rebuild:native:electron",
    "package": "electron-forge package",
    "prepackage": "npm run rebuild:native:electron",
    "make": "electron-forge make",
    "premake": "npm run rebuild:native:electron",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "rebuild:native:electron": "electron-rebuild -f -w better-sqlite3",
    "pretest": "npm run rebuild:native:node",
    "test": "vitest",
    "pretest:run": "npm run rebuild:native:node",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@hello-pangea/dnd": "^18.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-resizable-panels": "^4.11.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-dmg": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "@electron-forge/plugin-fuses": "^7.5.0",
    "@electron-forge/plugin-vite": "^7.5.0",
    "@electron-forge/shared-types": "^7.5.0",
    "@electron/fuses": "^1.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "electron": "^33.2.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.0.0"
  }
}
